# ── Sentinel Environment Configuration ────────────────────────────
# Copy this file to .env and fill in your values.
# All variables are loaded by pydantic-settings from src/core/config.py

# PostgreSQL async connection URL (str)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinel

# Redis URL for velocity tracking and Celery broker (str)
REDIS_URL=redis://localhost:6379

# HuggingFace API token for LLM inference (str)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# JWT signing key — must be at least 32 characters (str)
SECRET_KEY=change-me-in-production-min-32-chars!!

# Static API key for simple auth (str)
API_KEY=your_secret_api_key_here

# MLflow tracking server URI (str)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Path to the MLflow model artifact directory (str)
MODEL_PATH=fraud_model

# Cost matrix for Bayes-optimal threshold (float)
FRAUD_FP_COST=5.0
FRAUD_FN_COST=850.0

# A/B testing: percentage of traffic to challenger model (int, 0-100)
AB_CHALLENGER_PCT=10

# PSI threshold that triggers a retrain alert (float)
DRIFT_THRESHOLD=0.2

# Python log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (str)
LOG_LEVEL=INFO

# Runtime environment: development, staging, production (str)
ENVIRONMENT=development

# Allowed CORS origins, comma-separated (list[str])
CORS_ORIGINS=["http://localhost:8501"]

# Rate limiting: max requests per minute (int)
RATE_LIMIT_PER_MINUTE=60

# Frontend configuration (used by docker-compose)
API_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8501

# Champion model version tag (str)
CHAMPION_MODEL_VERSION=latest

# Challenger model path and version — leave empty to disable A/B (str)
# CHALLENGER_MODEL_PATH=
# CHALLENGER_MODEL_VERSION=
