FROM python:3.11-slim AS builder
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir build && \
    pip install --no-cache-dir ".[dev]" || true

FROM python:3.11-slim AS runtime
WORKDIR /app
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY sentinel/src/ ./sentinel/src/
COPY sentinel/ml/ ./sentinel/ml/
COPY sentinel/workers/ ./sentinel/workers/
COPY fraud_model/ ./fraud_model/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "sentinel.src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
