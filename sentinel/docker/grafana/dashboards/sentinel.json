{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "panels": [
    {
      "title": "Predictions Total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(sentinel_predictions_total)",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "title": "Prediction Latency (p95)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(sentinel_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "title": "Fraud Rate (1h)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sentinel_fraud_rate_1h",
          "legendFormat": "Rate"
        }
      ]
    },
    {
      "title": "Active WebSocket Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sentinel_websocket_connections_active",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "title": "Model Confidence Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sentinel_model_confidence_bucket",
          "legendFormat": "{{ab_variant}}"
        }
      ]
    },
    {
      "title": "Predictions by Action",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (action) (sentinel_predictions_total)",
          "legendFormat": "{{action}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["sentinel", "fraud-detection"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Sentinel Fraud Intelligence",
  "uid": "sentinel-dashboard"
}
